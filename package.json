{
  "name": "universe.me",
  "private": true,
  "description": "Desktop worldbuilding app: worlds, timelines, themes, and an AI-ready API.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^24.21.0"
  },
  "scripts": {
    "dev": "pnpm --filter universe-desktop dev",
    "build": "pnpm --filter universe-desktop build",
    "dist": "pnpm --filter universe-desktop dist",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter universe-desktop test:e2e",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
