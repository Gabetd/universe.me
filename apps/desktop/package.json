    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@universe/core": "workspace:*",
    "@universe/db": "workspace:*",
    "@universe/procgen": "workspace:*",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "vite": "^7.3.7",
    "zustand": "^5.0.15"
  }
}
