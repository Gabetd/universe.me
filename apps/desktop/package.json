{
  "name": "universe-desktop",
  "productName": "Universe",
  "version": "0.1.0",
  "private": true,
  "description": "universe.me desktop worldbuilding app",
  "author": "universe.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gabetd/universe.me.git"
  },
  "desktopName": "universe.desktop",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
